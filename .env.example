# Copy to .env and fill in. Never commit .env.
# Leave a value blank and its connector stays disabled.

# --- Core ---
WZM_ENV=dev
WZM_DATABASE_URL=postgresql://wzm:wzm@localhost:5432/wzm
WZM_DATA_DIR=./data
WZM_STREAMS_FILE=./config/datastreams.yaml
WZM_SCENARIO_FILE=./config/scenario_defaults.yaml   # defaults for the scenario analysis map

# --- Road network (detour routing) ---
OVERPASS_URL=https://overpass-api.de/api/interpreter   # OpenStreetMap Overpass API; point at your own instance for heavy use

# --- Work zone events ---
WZDX_FEED_URL=                # TODO: your agency's WZDx feed (GeoJSON), see USDOT WZDx registry
WZDX_API_KEY=                 # TODO: only if the feed requires one
PERMITS_API_URL=              # TODO: lane closure permit system endpoint
PERMITS_API_KEY=              # TODO

# --- Speeds / travel times ---
NPMRDS_USERNAME=              # TODO: RITIS / NPMRDS account
NPMRDS_PASSWORD=              # TODO
INRIX_APP_ID=                 # TODO: INRIX app id
INRIX_HASH_TOKEN=             # TODO: INRIX hash token
HERE_API_KEY=                 # TODO: HERE Traffic API key

# --- Volumes / detectors ---
DETECTORS_API_URL=            # TODO: ATMS / detector data endpoint
DETECTORS_API_KEY=            # TODO

# --- Context ---
CRASHES_DB_URL=               # TODO: state crash database (or file export path)
NOAA_API_TOKEN=               # TODO: NOAA CDO token (api.weather.gov needs none)
NOAA_USER_AGENT=wzm (contact@example.org)   # TODO: api.weather.gov requires a contact
EVENTS_API_URL=               # TODO: special events calendar
INCIDENTS_API_URL=            # TODO: TMC incident log / 511 feed
INCIDENTS_API_KEY=            # TODO

# --- Outbound alerts ---
DMS_API_URL=                  # TODO: dynamic message sign control system
DMS_API_KEY=                  # TODO
ALERT_511_URL=                # TODO
SMTP_URL=                     # TODO: smtp://user:pass@host:587
ALERT_EMAIL_TO=               # TODO
